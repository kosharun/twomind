{
  "name": "twomind",
  "version": "0.1.2",
  "description": "Two-way memory for AI coding. Your AI remembers how you build. You remember what it built, and why.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosharun/twomind.git"
  },
  "homepage": "https://github.com/kosharun/twomind#readme",
  "bugs": {
    "url": "https://github.com/kosharun/twomind/issues"
  },
  "bin": {
    "twomind": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "install-global": "node scripts/install-global.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "agent",
    "memory",
    "code-comprehension",
    "diff",
    "developer-tools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/types": "7.29",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9"
  }
}
